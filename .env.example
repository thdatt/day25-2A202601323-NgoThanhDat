# Copy to `.env` and fill in. `.env` is git-ignored; never commit a real key.
# Required only for the live path: semantic_cache.py, eval_deepeval.py, eval_ragas.py,
# and `python scripts/run_all.py --live-eval`. Offline tests do not need it.
GOOGLE_API_KEY=your-google-api-key-here

# Optional: shared Redis cache (docker compose up -d). Defaults to this value.
REDIS_URL=redis://localhost:6379/0
